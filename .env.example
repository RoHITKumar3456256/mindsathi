# MindSaathi AI Configuration Template

# 1. Google Gemini (1M Token Context & Gemini-Embedding-001)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. OpenRouter - Ling 3.0 Flash Sante (Health & Medicine MoE 124B/5.1B active)
OPENROUTER_API_KEY_LING=your_openrouter_ling_key_here

# 3. OpenRouter - Inkling (Thinking Machines Multimodal MoE 975B/41B active)
OPENROUTER_API_KEY_INKLING=your_openrouter_inkling_key_here

# 4. Groq Ultra-Fast LPU Engine (Zero Downtime Fallback, Sub-second latency, Whisper Speech)
GROQ_API_KEY=your_groq_api_key_here

# 5. LangSmith & LangGraph Orchestration Tracing
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langchain_api_key_here
LANGCHAIN_PROJECT=MindSaathi-AI

# 6. Supabase Credentials (OAuth & Sync)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here

# 7. Figma Integration
FIGMA_API_KEY=your_figma_personal_access_token_here
FIGMA_FILE_ID=your_figma_file_id_here
